# 로컬은 기본값으로 충분하다. OCI에서는 .env로 복사해 수정한다.

# Kafka EXTERNAL listener가 클라이언트에게 알려주는 주소 (OCI: Tailscale IP 또는 MagicDNS 이름)
KAFKA_EXTERNAL_HOST=localhost
# 9092 포트를 바인딩할 호스트 IP (OCI: Tailscale IP. 0.0.0.0으로 공개하지 않는다)
KAFKA_EXTERNAL_BIND=127.0.0.1

# receiver 8080 포트 바인딩 IP (OCI: reverse proxy 구성에 맞춘다)
APP_BIND=127.0.0.1
# 실행할 이미지 태그 (latest 또는 sha-xxxxxxx)
APP_TAG=latest
